# Template for local development. Copy to .env and fill in real values.
# .env is gitignored; never commit real secrets.

# GitHub classic PAT with repo + workflow scope, used to push to
# https://github.com/CoworkLab/Os-Agent
GITHUB_TOKEN=

# Release signing. These feed the "Release APK" GitHub Actions workflow as
# repository secrets of the same name, not this file. Generate a keystore with:
#   keytool -genkeypair -v -keystore release.jks -alias jarvis \
#     -keyalg RSA -keysize 2048 -validity 10000
# Then base64 it for the JARVIS_KEYSTORE_BASE64 secret:
#   base64 -w0 release.jks
JARVIS_KEYSTORE_BASE64=
JARVIS_KEYSTORE_PASSWORD=
JARVIS_KEY_ALIAS=
JARVIS_KEY_PASSWORD=

# Optional publisher identity for the release build.
JARVIS_DEVELOPER_NAME=
JARVIS_COPYRIGHT_OWNER=
