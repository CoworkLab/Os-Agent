# Template for local development. Copy to .env and fill in real values.
# .env is gitignored; never commit real secrets.

# GitHub classic PAT with repo + workflow scope, used to push to
# https://github.com/CoworkLab/Os-Agent
GITHUB_TOKEN=

# --- Release signing, for local builds -------------------------------------
# These are the names app/build.gradle.kts reads (env var or Gradle property).
# Generate a keystore and derive its pin with:
#   keytool -genkeypair -v -keystore release.jks -alias jarvis \
#     -keyalg RSA -keysize 4096 -validity 10000
#   keytool -list -v -keystore release.jks -alias jarvis -storepass "$PW" \
#     | grep SHA256: | sed 's/.*SHA256: *//' | tr -d ': ' | tr a-f A-F
# Keep the keystore OUTSIDE this repository.
JARVIS_RELEASE_STORE_FILE=
JARVIS_RELEASE_STORE_PASSWORD=
JARVIS_RELEASE_KEY_ALIAS=
JARVIS_RELEASE_KEY_PASSWORD=
JARVIS_RELEASE_CERT_SHA256=

# Optional publisher identity. Defaults to "Tech GPTx" when blank.
JARVIS_DEVELOPER_NAME=
JARVIS_COPYRIGHT_OWNER=

# Optional remote attestation endpoint. Leave blank: the app reports remote
# verification as unavailable until a service exists.
JARVIS_VERIFICATION_ENDPOINT=

# --- GitHub Actions --------------------------------------------------------
# The Release APK workflow reads these repository *secrets*, which have
# different names from the local variables above. Set them with:
#   gh secret set JARVIS_KEYSTORE_BASE64 < <(base64 -w0 release.jks)
# JARVIS_KEYSTORE_BASE64     base64 of the .jks
# JARVIS_KEYSTORE_PASSWORD
# JARVIS_KEY_ALIAS
# JARVIS_KEY_PASSWORD
# JARVIS_DEVELOPER_NAME / JARVIS_COPYRIGHT_OWNER (optional)
# The certificate pin is derived from the keystore at build time, so it is not
# a separate secret.
